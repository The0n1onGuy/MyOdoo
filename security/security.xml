<odoo>
    <data noupdate="0">
        <record id="module_category_shopping_cart" model="ir.module.category">
            <field name="name">Shopping Cart</field>
            <field name="description">Niveles de acceso para la tienda</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_shopping_user" model="res.groups">
            <field name="name">Usuario / Comprador</field>
            <field name="category_ids" ref="shopping_cart.module_category_shopping_cart"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_shopping_manager" model="res.groups">
            <field name="name">Administrador /  Admnistrador</field>
            <field name="category_ids" ref="shopping_cart.module_category_shopping_cart"/>
            <field name="implied_ids" eval="[(4, ref('group_shopping_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>