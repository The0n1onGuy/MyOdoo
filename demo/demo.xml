<odoo>
    <data noupdate="1">
        <record id="status_activo" model="pos.status">
            <field name="name">Activo</field>
            <field name="status_name">ACTIVO</field>
        </record>

        <record id="status_inactivo" model="pos.status">
            <field name="name">Inactivo</field>
            <field name="status_name">INACTIVO</field>
        </record>

        <record id="cat_hardware" model="pos.category">
            <field name="name">Hardware</field>
            <field name="description">Componentes físicos y periféricos</field>
        </record>

        <record id="cat_lego" model="pos.category">
            <field name="name">LEGO</field>
            <field name="description">Marca reconocida de juguetes de construccion</field>
        </record>

        <record id="cat_megaconstrux" model="pos.category">
            <field name="name">MEGACONSTRUX</field>
            <field name="description">Juguetes de construccion reconocida por videojuegos</field>
        </record>

        <record id="cat_software" model="pos.category">
            <field name="name">Software</field>
            <field name="description">Licencias y servicios digitales</field>
        </record>

        <record id="prod_mouse" model="pos.product">
            <field name="name">Gaming Mouse Pro</field>
            <field name="sku">HW-001</field>
            <field name="base_price">59.99</field>
            <field name="category_id" ref="cat_hardware"/>
            <field name="status_id" ref="status_activo"/>
        </record>

        <record id="prod_license" model="pos.product">
            <field name="name">Nexus Cloud License</field>
            <field name="sku">SW-001</field>
            <field name="base_price">199.00</field>
            <field name="category_id" ref="cat_software"/>
            <field name="status_id" ref="status_activo"/>
        </record>

        <record id="inv_mouse" model="pos.inventory">
            <field name="product_id" ref="prod_mouse"/>
            <field name="current_stock">50</field>
            <field name="min_stock">10</field>
        </record>
    </data>
</odoo>
