<odoo>
    <data>
        <record id="website.default_website" model="website">
            <field name="name">OnionSale</field>
        </record>
        <template id="combined_store_view" name="MercadoLibre Style Store">
    <t t-call="website.layout">
        <div class="container mt-4">
            <section id="offers" class="mb-5">
                <h2 class="text-danger"><i class="fa fa-snowflake-o"/> Ofertas de Temporada</h2>
                <div class="row">
                    <t t-foreach="seasonal" t-as="bundle">
                        <div class="col-md-6 mb-3">
                            <div class="card border-danger shadow">
                                <div class="card-body">
                                    <h4 t-field="bundle.name"/>
                                    <p class="text-muted">Ahorra comprando el paquete completo</p>
                                    <div class="d-flex align-items-center">
                                        <span class="text-decoration-line-through text-muted me-2">
                                            $<t t-esc="'%.2f' % bundle.total_normal_value"/>
                                        </span>
                                        <span class="h3 text-danger">$<t t-esc="'%.2f' % bundle.bundle_price"/></span>
                                    </div>
                                    <button class="btn btn-danger mt-2">Añadir Bundle</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>

            <section id="bundles" class="mb-5">
                <h3>Explorar Paquetes</h3>
                <div class="list-group">
                    <t t-foreach="bundles" t-as="b">
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <strong t-field="b.name"/>
                                <small class="d-block text-muted" t-field="b.reference"/>
                            </div>
                            <span class="badge bg-primary rounded-pill">$<t t-esc="'%.2f' % b.bundle_price"/></span>
                        </a>
                    </t>
                </div>
            </section>

            <section id="products">
                <h3>Productos Individuales</h3>
                <div class="row">
                    <t t-foreach="products" t-as="p">
                        <div class="col-md-3 mb-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 t-field="p.name"/>
                                    <p class="text-primary">$<t t-esc="p.base_price"/></p>
                                    <button class="btn btn-sm btn-outline-primary w-100">Ver Opciones</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </div>
    </t>
</template>

