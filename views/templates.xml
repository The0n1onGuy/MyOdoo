<odoo>
    <data>
        <!-- ========================================== -->
        <!-- 1. TEMPLATE: SEASONAL OFFERS PAGE          -->
        <!-- ========================================== -->
        <template id="page_offers" name="Ofertas">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">

                    <!-- SECTION A: SEASONAL OFFERS (Only shows if 'seasonal' has records) -->
                    <t t-if="seasonal">
                        <h2 class="text-danger mb-4"><i class="fa fa-snowflake-o"/> Ofertas de Temporada</h2>
                        <div class="row mb-5">
                            <t t-foreach="seasonal" t-as="bundle">
                                <div class="col-md-6 mb-3">
                                    <div class="card border-danger shadow">
                                        <div class="card-body">
                                            <h4 t-field="bundle.name"/>
                                            <p class="text-muted">Ahorra comprando el paquete completo</p>
                                            <div class="d-flex align-items-center">
                                                <span class="text-decoration-line-through text-muted me-2">
                                                    $<t t-esc="'%.2f' % bundle.total_normal_value"/>
                                                </span>
                                                <span class="h3 text-danger">$<t t-esc="'%.2f' % bundle.bundle_price"/></span>
                                            </div>
                                            <button class="btn btn-danger mt-2">Añadir Bundle</button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- SECTION B: NORMAL OFFERS -->
                    <h2 class="text-primary mb-4"><i class="fa fa-tags"/> Ofertas Regulares</h2>
                    <div class="row">
                        <t t-if="not normal_offers">
                            <div class="col-12">
                                <div class="alert alert-info">Actualmente no hay ofertas regulares activas. ¡Vuelve pronto!</div>
                            </div>
                        </t>

                        <t t-foreach="normal_offers" t-as="offer">
                            <div class="col-md-4 mb-3">
                                <div class="card border-primary shadow-sm h-100">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-primary font-weight-bold" t-field="offer.name"/>
                                        <!-- Adjust these fields depending on what is inside your pos.offer model -->
                                        <p class="card-text text-muted">Descuento aplicado: <span t-field="offer.discount_value"/></p>

                                        <div class="mt-auto pt-3 border-top">
                                            <button class="btn btn-outline-primary w-100">Ver Detalles</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                </div>
            </t>
        </template>

        <!-- ========================================== -->
        <!-- 2. TEMPLATE: BUNDLES PAGE                  -->
        <!-- ========================================== -->
        <template id="page_bundles" name="Explorar Paquetes">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <h2 class="mb-4">Explorar Paquetes</h2>
                    <div class="list-group shadow-sm">
                        <t t-if="not bundles">
                            <div class="alert alert-info">No hay paquetes disponibles en este momento.</div>
                        </t>
                        <t t-foreach="bundles" t-as="b">
                            <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <strong class="fs-5" t-field="b.name"/>
                                    <small class="d-block text-muted" t-field="b.reference"/>
                                </div>
                                <span class="badge bg-primary rounded-pill fs-6">$<t t-esc="'%.2f' % b.bundle_price"/></span>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- ========================================== -->
        <!-- 3. TEMPLATE: PRODUCTS PAGE (Grid Layout)   -->
        <!-- ========================================== -->
        <template id="page_products" name="Catálogo de Productos">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-12">
                            <h2 class="display-4 mb-4">Catálogo de Productos</h2>
                        </div>
                    </div>
                    <div class="row">
                        <t t-if="not products">
                            <div class="col-12">
                                <div class="alert alert-info">No hay productos en el catálogo.</div>
                            </div>
                        </t>
                        <t t-foreach="products" t-as="product">
                            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                                <div class="card h-100 shadow-sm border-0 rounded-lg">
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                        <i class="fa fa-shopping-bag fa-3x text-muted"/>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <span class="badge bg-secondary mb-2 align-self-start" t-field="product.category_id.name"/>
                                        <h5 class="card-title font-weight-bold" t-field="product.name"/>
                                        <p class="card-text text-muted small" t-field="product.sku"/>
                                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                            <span class="h5 mb-0 text-primary">$<span t-field="product.base_price"/></span>
                                            <button class="btn btn-outline-dark btn-sm rounded-pill px-3 add-to-cart"
                                                    t-att-data-product-id="product.id">
                                                Seleccionar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- ========================================== -->
        <!-- WEBSITE MENUS (Top Navigation Bar)         -->
        <!-- ========================================== -->
        <record id="menu_website_offers" model="website.menu">
            <field name="name">Ofertas</field>
            <field name="url">/ofertas</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_website_bundles" model="website.menu">
            <field name="name">Paquetes</field>
            <field name="url">/paquetes</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_website_products" model="website.menu">
            <field name="name">Productos</field>
            <field name="url">/productos</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
        </record>

    </data>
</odoo>