<odoo>
  <data>
    <record id="website.default_website" model="website">
      <field name="name">OnionSale</field>
    </record>

    <!-- VIEWS -->
    <record id="view_pos_inventory_tree" model="ir.ui.view">
      <field name="name">pos.inventory.tree</field>
      <field name="model">pos.inventory</field>
      <field name="arch" type="xml">
          <list editable="bottom">
              <field name="current_stock"/>
              <field name="min_stock"/>
              <field name="last_restock_date"/>
          </list>
      </field>
    </record>

    <record id="view_pos_bundle_line_tree" model="ir.ui.view">
        <field name="name">pos.bundle.line.tree</field>
        <field name="model">pos.bundle.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <record id="view_pos_product_form" model="ir.ui.view">
      <field name="name">pos.product.form</field>
      <field name="model">pos.product</field>
      <field name="arch" type="xml">
          <form>
              <sheet>
                  <div class="oe_title">
                      <h1><field name="name" placeholder="Nombre del Producto"/></h1>
                      <h3>SKU: <field name="sku"/></h3>
                  </div>
                  <notebook>
                      <page string="General" name="general_info">
                          <group>
                              <field name="category_id"/>
                              <field name="base_price"/>
                              <field name="discounted_price" readonly="1"/>
                              <field name="status_id"/>
                          </group>
                      </page>
                      <page string="Inventario" name="inventory">
                        <field name="inventory_id" context="{'list_view_ref': 'shopping_cart.view_pos_inventory_tree'}"/>
                      </page>
                  </notebook>
              </sheet>
          </form>
      </field>
    </record>

    <record id="view_pos_bundle_form" model="ir.ui.view">
        <field name="name">pos.bundle.form</field>
        <field name="model">pos.bundle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_seasonal_offer" widget="boolean_toggle"/>
                    <span>¿Es oferta de temporada?</span>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference"/>
                    </group>
                    <notebook>
                        <page string="Productos Incluidos">
                            <field name="line_ids" context="{'list_view_ref': 'shopping_cart.view_pos_bundle_line_tree'}"/>
                        </page>
                        <page string="Configuración de Precio">
                            <group>
                                <field name="total_normal_value" decoration-info="1"/>
                                <field name="bundle_price" widget="monetary" string="Precio Final del Bundle"/>
                                <p class="text-muted">Nota: El precio por defecto aplica un 10% de descuento sobre el valor normal.</p>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

   <!-- Action for Offers -->
    <record id="action_pos_offer" model="ir.actions.act_window">
        <field name="name">Ofertas Activas</field>
        <field name="res_model">pos.offer</field>
        <!-- CHANGE IS HERE: list instead of tree -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera oferta!
            </p>
        </field>
    </record>

    <!-- Action for Bundles -->
    <record id="action_pos_bundle" model="ir.actions.act_window">
        <field name="name">Paquetes (Bundles)</field>
        <field name="res_model">pos.bundle</field>
        <!-- CHANGE IS HERE: list instead of tree -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer paquete de productos!
            </p>
        </field>
    </record>

    <!-- Action for Products -->
    <record id="action_pos_product" model="ir.actions.act_window">
        <field name="name">Productos e Inventario</field>
        <field name="res_model">pos.product</field>
        <!-- CHANGE IS HERE: list instead of tree -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer producto!
            </p>
        </field>
    </record>
    <!-- MENUS -->
    <menuitem id="menu_shopping_cart_root"
          name="OnionShop"
          web_icon="shopping_cart,static/description/icon.png"/>

    <menuitem id="menu_offers_tab"
          name="Ofertas Activas"
          parent="menu_shopping_cart_root"
          action="action_pos_offer"
          sequence="10"
          groups="base.group_system"/>

    <menuitem id="menu_bundles_tab"
          name="Paquetes (Bundles)"
          parent="menu_shopping_cart_root"
          action="action_pos_bundle"
          sequence="20"/>

    <menuitem id="menu_products_tab"
          name="Productos e Inventario"
          parent="menu_shopping_cart_root"
          action="action_pos_product"
          sequence="30"/>

  </data>
</odoo>